{
  "name": "darex",
  "version": "0.1.0",
  "private": true,
  "description": "Darex \u2014 Multi-tenant AI Employee SaaS Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @darex/dashboard dev",
    "dev:all": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "start:stack": "bash ./start.sh",
    "start:stack:dev": "bash ./start.sh --dev",
    "infra:up": "bash infra/scripts/compose-cmd.sh up -d",
    "infra:down": "bash infra/scripts/compose-cmd.sh down",
    "infra:logs": "docker-compose -f infra/docker-compose.yml logs -f",
    "infra:reset": "docker-compose -f infra/docker-compose.yml down -v",
    "db:migrate": "node infra/db/migrate.js",
    "deploy": "bash ./deploy/deploy.sh",
    "db:seed": "node infra/db/seed.js",
    "worker:start": "pnpm --filter @darex/workflows run build && pnpm --filter @darex/workflows run start",
    "demo:e2e": "pnpm --filter @darex/shared-types build && pnpm --filter @darex/workflows exec tsc --noEmit && pnpm --filter @darex/workflows build && pnpm --filter @darex/workflows exec node dist/scripts/demo-e2e.js",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "axios@<1.20.0": "^1.20.0",
      "fast-uri@<3.1.8": "^3.1.8",
      "@grpc/grpc-js@<1.14.5": "^1.14.5",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.23": "^8.5.23",
      "nodemailer@<10.0.6": "^10.0.6",
      "hono@<4.13.7": "^4.13.7",
      "ip-address@<10.7.1": "^10.7.1",
      "qs@<6.16.0": "^6.16.0",
      "yaml@<2.8.3": "^2.8.3",
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.11.0": "^1.11.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "katex@<0.18.2": "^0.18.2",
      "@modelcontextprotocol/sdk@<1.31.0": "^1.31.0"
    }
  }
}
