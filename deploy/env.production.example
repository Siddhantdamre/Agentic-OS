# Copy to the server as /path/to/repo/.env (gitignored). Placeholders only.
# Callers: deploy/deploy.sh env check. Never commit real secrets.
#
# Prod fail-fast (deploy.sh refuses to boot otherwise):
#   DB_USER=darex_app
#   ALLOW_DEMO_AUTH=false
# Runtime containers use darex_app. Migrations still connect as superuser darex.

# Public URL the browser and Meta webhooks use (https).
NEXT_PUBLIC_APP_URL=https://app.example.com
ALLOW_DEMO_AUTH=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=darex
# Compose postgres superuser (migrations). Must match POSTGRES.
POSTGRES_USER=darex
DB_PASSWORD=replace-with-long-random
# Runtime role used by dashboard + worker containers. Must stay darex_app
# in production (least privilege + RLS). deploy.sh fail-fasts otherwise.
APP_DB_USER=darex_app
APP_DB_PASSWORD=replace-with-other-long-random
DB_USER=darex_app

SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=replace-with-long-random
DAREX_SESSION_SECRET=replace-with-long-random

# Must be Nango's UUID from the Nango UI / logs. A non-UUID string
# makes every tool return notConnected.
NANGO_SECRET_KEY=00000000-0000-0000-0000-000000000000
NANGO_HOST=http://localhost:3003
NEXT_PUBLIC_NANGO_HOST=https://app.example.com
NEXT_PUBLIC_NANGO_PUBLIC_KEY=

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=replace-with-long-random
OPENROUTER_API_KEY=sk-or-replace-me

ATOMIC_AGENT_URL=http://127.0.0.1:8787
ATOMIC_AGENT_API_KEY=replace-with-long-random
ATOMIC_AGENT_TIMEOUT_MS=300000
ATOMIC_AGENT_ACTIVE_PROVIDER=darex-litellm

JINA_API_KEY=
SANDBOX_API_URL=http://localhost:8080
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=replace-with-meta-verify-token
CHATWOOT_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM=

LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-replace-me
LANGFUSE_SECRET_KEY=sk-lf-replace-me

# Darex platform billing (B2). Staging: DAREX_BILLING_REQUIRED=true.
# Paste test-mode keys from the Darex Stripe/Razorpay accounts. Not org PSP tools.
DAREX_BILLING_REQUIRED=true
DAREX_STRIPE_SECRET_KEY=
DAREX_STRIPE_WEBHOOK_SECRET=
DAREX_STRIPE_PRICE_STARTER=
DAREX_STRIPE_PRICE_GROWTH=
DAREX_STRIPE_PRICE_ENTERPRISE=
DAREX_STRIPE_PRICE_ADDON_SEAT=
DAREX_RAZORPAY_KEY_ID=
DAREX_RAZORPAY_KEY_SECRET=
DAREX_RAZORPAY_WEBHOOK_SECRET=
DAREX_RAZORPAY_PLAN_STARTER=
DAREX_RAZORPAY_PLAN_GROWTH=
DAREX_RAZORPAY_PLAN_ENTERPRISE=

# SSO (S7). SUPERTOKENS_SAML_TEST_IDP=true is forbidden in production.
# Password login stays enabled when these are empty.
SUPERTOKENS_SAML_TEST_IDP=false
SUPERTOKENS_SAML_BOXY_URL=
SUPERTOKENS_SAML_CLIENT_ID=
SUPERTOKENS_SAML_CLIENT_SECRET=
