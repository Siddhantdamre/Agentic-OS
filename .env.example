# Copy to .env (gitignored). Callers: compose env_file, dashboard process.env.
# Glob found no .env.example. Placeholders only — never real secrets.
# User: "Env example files if they exist and are incomplete (never commit real secrets)"

DB_HOST=localhost
DB_PORT=5432
DB_USER=darex_app
DB_PASSWORD=darex_app_dev_secret
DB_NAME=darex
DASHBOARD_PORT=3000
# Runtime default is darex_app (least privilege). Migrations still connect as
# superuser darex via infra/db/migrate.js. Compose dashboard/worker:
# APP_DB_USER / APP_DB_PASSWORD (defaults darex_app / darex_app_dev_secret).

SUPERTOKENS_CONNECTION_URI=http://localhost:3567
SUPERTOKENS_API_KEY=changeme
DAREX_SESSION_SECRET=changeme
NEXT_PUBLIC_APP_URL=http://localhost:3000
# H6 widget snippet uses this origin for /embed/widget.js. Public site key only — no secrets in the JS.
ALLOW_DEMO_AUTH=false

NANGO_HOST=http://localhost:3003
NANGO_SECRET_KEY=00000000-0000-0000-0000-000000000000
NEXT_PUBLIC_NANGO_PUBLIC_KEY=
NEXT_PUBLIC_NANGO_HOST=http://localhost:3003

LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=changeme
# Embed-worker (WS-04 / M2). Env-only model name (Q3). Dim must match migration 013 vector(1536).
# Unset EMBEDDING_MODEL in production fails the Temporal worker, not webhooks.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# Optional Docling serve URL for PDF/Office ingest (WS-15). Unset → honest skip for binary files.
DOCLING_URL=
OPENROUTER_API_KEY=
ATOMIC_AGENT_URL=http://127.0.0.1:8787
ATOMIC_AGENT_API_KEY=changeme
ATOMIC_AGENT_TIMEOUT_MS=300000
ATOMIC_AGENT_ACTIVE_PROVIDER=darex-litellm

JINA_API_KEY=
SANDBOX_API_URL=http://localhost:8080
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
VERIFY_TOKEN=changeme
# Same value for dashboard Chatwoot HMAC and the inbox gateway on :3004
CHATWOOT_WEBHOOK_SECRET=

RESEND_API_KEY=
MAIL_FROM=

LANGFUSE_HOST=http://localhost:3002
LANGFUSE_PUBLIC_KEY=pk-lf-darex-dev-public
LANGFUSE_SECRET_KEY=sk-lf-darex-dev-secret

# SSO SAML/OIDC on SuperTokens (WS-22 / S7). Password login stays enabled
# when these are unset. Production forbids SUPERTOKENS_SAML_TEST_IDP=true.
# Test IdP (dev/staging only):
#   1. Run BoxyHQ Jackson on :5225 (https://github.com/boxyhq/jackson)
#   2. Register mocksaml.com (or your IdP) in Jackson
#   3. SUPERTOKENS_SAML_TEST_IDP=true
#      optional overrides: SUPERTOKENS_SAML_BOXY_URL / CLIENT_ID / CLIENT_SECRET
# Production: paste real Boxy URL + client id/secret. No localhost defaults.
SUPERTOKENS_SAML_TEST_IDP=false
SUPERTOKENS_SAML_BOXY_URL=
SUPERTOKENS_SAML_CLIENT_ID=
SUPERTOKENS_SAML_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_DOMAIN=
AZURE_AD_DIRECTORY_ID=

# Wave A/B public / BYOK connectors (placeholders only). OAuth client IDs
# for Outlook/Salesforce/DocuSign live in Nango UI, not here.
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public URL Twilio uses to sign SMS webhooks (defaults to NEXT_PUBLIC_APP_URL/api/webhooks/sms).
TWILIO_WEBHOOK_URL=
# Gmail Pub/Sub push token. Required in production. Never commit the real value.
GMAIL_PUSH_TOKEN=
# Owner WhatsApp is a DISTINCT number from the customer WABA (H5).
# Meta token rotation is ops — infra/scripts/OPERATOR_HYGIENE.md §4.
OWNER_WHATSAPP_PHONE_NUMBER_ID=
OWNER_WHATSAPP_VERIFY_TOKEN=
# Registered owner mobile (digits) allowed to approve/pause/brief on the owner number.
OWNER_WHATSAPP_OWNER_PHONE=
SALESFORCE_INSTANCE_URL=
DOCUSIGN_OAUTH_BASE_URL=
# Wave B leftovers (C6). OAuth client IDs live in Nango UI, not here.
ZOHO_API_DOMAIN=
LEEGALITY_API_TOKEN=
LEEGALITY_API_BASE_URL=
LEEGALITY_PROFILE_ID=
QUICKBOOKS_API_BASE_URL=
QUICKBOOKS_ENVIRONMENT=
QUICKBOOKS_REALM_ID=

# ---------------------------------------------------------------------------
# Darex platform billing (B2) — NOT org Stripe/Razorpay payment-link tools.
# Those live in Nango / agent tools. These keys bill Darex subscriptions.
# Placeholders only. Never commit live sk_live / rzp_live secrets.
# Staging: set DAREX_BILLING_REQUIRED=true so missing keys refuse boot.
# Prod: partial key sets refuse boot; checkout 503s and creates no invoice.
# ---------------------------------------------------------------------------
DAREX_BILLING_REQUIRED=false
DAREX_STRIPE_SECRET_KEY=
DAREX_STRIPE_WEBHOOK_SECRET=
# Stripe Price ids from the Darex Stripe account (test mode for staging).
DAREX_STRIPE_PRICE_STARTER=
DAREX_STRIPE_PRICE_GROWTH=
DAREX_STRIPE_PRICE_ENTERPRISE=
DAREX_STRIPE_PRICE_ADDON_SEAT=
DAREX_RAZORPAY_KEY_ID=
DAREX_RAZORPAY_KEY_SECRET=
DAREX_RAZORPAY_WEBHOOK_SECRET=
# Razorpay Plan ids from the Darex Razorpay account (test mode for staging).
DAREX_RAZORPAY_PLAN_STARTER=
DAREX_RAZORPAY_PLAN_GROWTH=
DAREX_RAZORPAY_PLAN_ENTERPRISE=
# Catalog display only. Checkout uses Price/Plan ids above, not these amounts.
DAREX_PLAN_CURRENCY=
DAREX_PLAN_STARTER_AMOUNT_CENTS=
DAREX_PLAN_GROWTH_AMOUNT_CENTS=
DAREX_PLAN_ENTERPRISE_AMOUNT_CENTS=
DAREX_SEAT_AMOUNT_CENTS=
DAREX_SEAT_MAX=50
DAREX_METER_LLM_SOFT_USD=50
DAREX_METER_LLM_HARD_USD=200
DAREX_METER_WHATSAPP_SOFT=500
DAREX_METER_WHATSAPP_HARD=2000
DAREX_METER_SEAT_SOFT=5
DAREX_METER_SEAT_HARD=25

# Microsoft / Azure AD OIDC (S7). Unset → Microsoft SSO hidden; password still works.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
