+function isRecord(value: unknown): value is Record<string, unknown> {
+  return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function sanitizePropertySchema(value: unknown): unknown {
+  if (!isRecord(value)) {
+    return value;
+  }
+  const result: Record<string, unknown> = { ...value };
+  if (result['type'] === 'array') {
+    const items = result['items'];
+    if (!isRecord(items) || Object.keys(items).length === 0) {
+      result['items'] = { type: 'string' };
+    } else {
+      result['items'] = sanitizePropertySchema(items);
+    }
+  }
+  const properties = result['properties'];
+  if (isRecord(properties)) {
+    const props: Record<string, unknown> = {};
+    for (const [k, v] of Object.entries(properties)) {
+      props[k] = sanitizePropertySchema(v);
+    }
+    result['properties'] = props;
+  }
+  return result;
+}
+
+function sanitizeProperties(properties: Record<string, unknown>): Record<string, unknown> {
+  const result: Record<string, unknown> = {};
+  for (const [k, v] of Object.entries(properties)) {
+    result[k] = sanitizePropertySchema(v);
+  }
+  return result;
+}
+
 export async function convertMCPServersToTools(params: {
